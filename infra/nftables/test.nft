#!/usr/sbin/nft -f
# test-vm: ssh in from orch-vm only; egress only DNS + package repositories (Go proxy, npm, PyPI, apt).
table inet aigate
delete table inet aigate
table inet aigate {
  set allow_web4 { type ipv4_addr; flags timeout; timeout 1d; }
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    ip saddr 10.70.0.0/24 udp sport 67 udp dport 68 accept
    ip saddr 10.70.0.11 tcp dport 22 accept
  }
  chain forward { type filter hook forward priority 0; policy drop; }
  chain output {
    type filter hook output priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    oif "lo" accept
    udp sport 68 udp dport 67 accept
    ip daddr 8.8.8.8 udp dport 53 accept
    ip daddr 8.8.8.8 tcp dport 53 accept
    ip daddr @allow_web4 tcp dport { 80, 443 } accept
  }
}
